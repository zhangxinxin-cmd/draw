        <mxCell id="EM91FzFee0Q-i1dhf6ZN-34" value="&lt;pre style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px; color: rgb(0, 0, 0); background-color: rgb(255, 255, 255);&quot; face=&quot;Lucida Console&quot;&gt;for (;;) {&lt;br&gt;    Node h = head;&lt;br&gt;    if (h != null &amp;amp;&amp;amp; h != tail) {&lt;br&gt;        int ws = h.waitStatus;&lt;br&gt;        if (ws == Node.&lt;span style=&quot;font-style: italic;&quot;&gt;SIGNAL&lt;/span&gt;) {&lt;br&gt;            if (!&lt;span style=&quot;font-style: italic;&quot;&gt;compareAndSetWaitStatus&lt;/span&gt;(h, Node.&lt;span style=&quot;font-style: italic;&quot;&gt;SIGNAL&lt;/span&gt;, 0))&lt;br&gt;                continue;            // loop to recheck cases&lt;br&gt;            unparkSuccessor(h);&lt;br&gt;        }&lt;br&gt;        else if (ws == 0 &amp;amp;&amp;amp;&lt;br&gt;                 !&lt;span style=&quot;font-style: italic;&quot;&gt;compareAndSetWaitStatus&lt;/span&gt;(h, 0, Node.&lt;span style=&quot;font-style: italic;&quot;&gt;PROPAGATE&lt;/span&gt;))&lt;br&gt;            continue;                // loop on failed CAS&lt;br&gt;    }&lt;br&gt;    if (h == head)                   // loop if head changed&lt;br&gt;        break;&lt;br&gt;}&lt;/font&gt;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="EM91FzFee0Q-i1dhf6ZN-35" vertex="1">
          <mxGeometry y="25" width="780" height="405" as="geometry" />
        </mxCell>
        <mxCell id="EM91FzFee0Q-i1dhf6ZN-37" value="&lt;font style=&quot;font-size: 20px;&quot; face=&quot;Lucida Console&quot;&gt;ws一般为Node.SIGNAL，尝试将h&lt;/font&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 20px;&quot; face=&quot;Lucida Console&quot;&gt;的等待&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 20px; font-family: &amp;quot;Lucida Console&amp;quot;;&quot;&gt;状态设置为Node.SIGNAL，成功即唤醒h的下一个节点封装的线程，直接退出循环。首次唤醒线程的肯定是在state变为0时（countDown()），才执行的。所以唤醒的第一个线程是哨兵节点的下一个节点。&lt;/span&gt;" style="shape=dataStorage;whiteSpace=wrap;html=1;fixedSize=1;align=left;spacingLeft=16;" parent="1" vertex="1">
          <mxGeometry x="110" y="1370" width="800" height="90" as="geometry" />
        </mxCell>
