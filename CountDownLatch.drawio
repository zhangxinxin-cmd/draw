        <mxCell id="EM91FzFee0Q-i1dhf6ZN-23" value="&lt;div&gt;&lt;pre style=&quot;&quot;&gt;&lt;font style=&quot;background-color: rgb(255, 255, 255); color: rgb(0, 0, 0); font-size: 20px;&quot; face=&quot;Lucida Console&quot;&gt;//设置node的mode设置为Node.SHARED&lt;/font&gt;&lt;/pre&gt;&lt;pre style=&quot;&quot;&gt;&lt;font style=&quot;background-color: rgb(255, 255, 255); font-size: 20px; color: rgb(0, 0, 0);&quot; face=&quot;Lucida Console&quot;&gt;&lt;span&gt;final &lt;/span&gt;Node node = addWaiter(Node.&lt;span style=&quot;font-style: italic;&quot;&gt;SHARED&lt;/span&gt;);&lt;br&gt;&lt;span&gt;boolean &lt;/span&gt;failed = &lt;span&gt;true&lt;/span&gt;;&lt;br&gt;&lt;span&gt;try &lt;/span&gt;{&lt;br&gt;    &lt;span&gt;for &lt;/span&gt;(;;) {&lt;br&gt;        &lt;span&gt;final &lt;/span&gt;Node p = node.predecessor();&lt;br&gt;        &lt;span&gt;if &lt;/span&gt;(p == &lt;span&gt;head&lt;/span&gt;) {&lt;/font&gt;&lt;/pre&gt;&lt;pre style=&quot;&quot;&gt;&lt;font style=&quot;background-color: rgb(255, 255, 255); font-size: 20px; color: rgb(0, 0, 0);&quot; face=&quot;Lucida Console&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;//判断state是否为０,0?１:-1&lt;br&gt;            &lt;span&gt;int &lt;/span&gt;r = tryAcquireShared(arg);&lt;br&gt;            &lt;span&gt;if &lt;/span&gt;(r &amp;gt;= &lt;span&gt;0&lt;/span&gt;) {&lt;br&gt;                setHeadAndPropagate(node, r);&lt;/font&gt;&lt;/pre&gt;&lt;pre style=&quot;&quot;&gt;&lt;font style=&quot;background-color: rgb(255, 255, 255); font-size: 20px; color: rgb(0, 0, 0);&quot; face=&quot;Lucida Console&quot;&gt;&lt;pre style=&quot;font-size: 12px; background-color: rgb(236, 236, 236);&quot;&gt;&lt;font style=&quot;background-color: rgb(255, 255, 255); font-size: 20px; color: rgb(0, 0, 0);&quot; face=&quot;Lucida Console&quot;&gt;// 将前驱节点的next置为空，注意，node的前驱节点已经为空&lt;/font&gt;&lt;/pre&gt;&lt;pre style=&quot;font-size: 12px; background-color: rgb(236, 236, 236);&quot;&gt;&lt;font style=&quot;background-color: rgb(255, 255, 255); font-size: 20px; color: rgb(0, 0, 0);&quot; face=&quot;Lucida Console&quot;&gt;//所以p没有任何对象引用它，会被垃圾回收。&lt;/font&gt;&lt;/pre&gt;                p.&lt;span&gt;next &lt;/span&gt;= &lt;span&gt;null&lt;/span&gt;; &lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;span&gt;                &lt;/span&gt;failed = &lt;span&gt;false&lt;/span&gt;;&lt;br&gt;                &lt;span&gt;return&lt;/span&gt;;&lt;br&gt;            }&lt;br&gt;        }&lt;br&gt;        &lt;span&gt;if &lt;/span&gt;(&lt;span style=&quot;font-style: italic;&quot;&gt;shouldParkAfterFailedAcquire&lt;/span&gt;(p, node)&lt;/font&gt;&lt;/pre&gt;&lt;pre style=&quot;&quot;&gt;&lt;font style=&quot;background-color: rgb(255, 255, 255); font-size: 20px; color: rgb(0, 0, 0);&quot; face=&quot;Lucida Console&quot;&gt;            &amp;amp;&amp;amp;parkAndCheckInterrupt())&lt;br&gt;            &lt;span&gt;throw new &lt;/span&gt;InterruptedException();&lt;br&gt;    }&lt;br&gt;} &lt;span&gt;finally &lt;/span&gt;{&lt;br&gt;    &lt;span&gt;if &lt;/span&gt;(failed)&lt;br&gt;        cancelAcquire(node);&lt;br&gt;}&lt;/font&gt;&lt;/pre&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;" parent="EM91FzFee0Q-i1dhf6ZN-22" vertex="1">
          <mxGeometry y="30" width="600" height="710" as="geometry" />
        </mxCell>
