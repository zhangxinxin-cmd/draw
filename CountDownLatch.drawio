        <mxCell id="EM91FzFee0Q-i1dhf6ZN-35" value="doReleaseShared源码" style="swimlane;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="130" y="940" width="780" height="430" as="geometry" />
