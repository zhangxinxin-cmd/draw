        <mxCell id="nyYqX1nxgzJ5DlLS-ViO-143" value="&lt;div&gt;&lt;pre style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); line-height: 100%;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0); font-size: 20px; line-height: 120%;&quot; face=&quot;Lucida Console&quot;&gt;int ws = node.waitStatus;&lt;br&gt;if (ws &amp;lt; 0)&lt;br&gt;    &lt;span style=&quot;font-style: italic;&quot;&gt;compareAndSetWaitStatus&lt;/span&gt;(node, ws, 0);&lt;br&gt;Node s = node.next;&lt;br&gt;if (s == null || s.waitStatus &amp;gt; 0) {&lt;br&gt;    s = null;&lt;br&gt;    for (Node t = tail; &lt;/font&gt;&lt;/span&gt;&lt;/pre&gt;&lt;pre style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); line-height: 100%;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0); font-size: 20px; line-height: 120%;&quot; face=&quot;Lucida Console&quot;&gt;         t != null&amp;amp;&amp;amp; t!= node; &lt;/font&gt;&lt;/span&gt;&lt;/pre&gt;&lt;pre style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); line-height: 100%;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0); font-size: 20px; line-height: 120%;&quot; face=&quot;Lucida Console&quot;&gt;         t = t.prev)&lt;br&gt;      if (t.waitStatus &amp;lt;= 0)&lt;br&gt;         s = t;&lt;br&gt;}&lt;br&gt;if (s != null)&lt;br&gt;    LockSupport.&lt;span style=&quot;font-style: italic;&quot;&gt;unpark&lt;/span&gt;(s.thread);&lt;/font&gt;&lt;/span&gt;&lt;/pre&gt;&lt;/div&gt;" style="shape=dataStorage;whiteSpace=wrap;html=1;fixedSize=1;align=left;spacingLeft=26;" vertex="1" parent="1">
